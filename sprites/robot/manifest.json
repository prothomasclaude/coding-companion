    "victory": {
      "frames": [
        28,
        32
      ],
      "speed": 200
    },
    "death": {
      "frames": [
        33,
        37
      ],
      "speed": 220
    }
  },
  "states": {
    "idle": {
      "animations": [
        "idle",
        "look",
        "waiting"
      ],
      "loop": true,
      "swapInterval": 6000
    },
    "working": {
      "animations": [
        "working",
        "running"
      ],
      "loop": true,
      "swapInterval": 5000
    },
    "waiting": {
      "animation": "waiting",
      "loop": true
    },
    "finished": {
      "animation": "finished",
      "loop": true,
      "duration": 3500,
      "then": {
        "animation": "victory",
        "loop": false,
        "thenIdle": true
      }
    }
  },
  "poke": {
    "deathAfter": 5,
    "deathAnimation": "death",
    "deathDuration": 3000
  },
